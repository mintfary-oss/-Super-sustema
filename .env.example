# Super Sistema — Конфигурация
# Скопируйте этот файл: cp .env.example .env
# Отредактируйте .env под ваши нужды

# ─── Безопасность ────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО смените на случайную строку!
# Сгенерировать: openssl rand -hex 32
WEBUI_SECRET_KEY=super-sistema-secret-CHANGE-THIS-VALUE

# ─── Порты ───────────────────────────────────────────────────────────────────
# Порт веб-интерфейса (открыть в браузере: http://localhost:3000)
WEBUI_PORT=3000

# ─── Аутентификация ──────────────────────────────────────────────────────────
# false = вход без пароля (для домашнего использования)
# true  = требует регистрации (для серверов с интернетом)
WEBUI_AUTH=false

# ─── Ollama настройки ────────────────────────────────────────────────────────
# Как долго держать модель загруженной в память после последнего запроса
# Примеры: 5m, 1h, 24h, -1 (никогда не выгружать)
OLLAMA_KEEP_ALIVE=24h

# Количество параллельных запросов (1 для CPU, 2-4 для GPU)
OLLAMA_NUM_PARALLEL=1

# Максимум одновременно загруженных моделей
OLLAMA_MAX_LOADED_MODELS=1

# ─── Модель по умолчанию ────────────────────────────────────────────────────
# Модель которая выбирается при открытии нового чата
# Доступные варианты (после скачивания):
#   phi3:mini        — 2.3 GB, минимальные требования
#   llama3.2:3b      — 2 GB, быстрый и умный
#   llama3.1:8b      — 4.7 GB, оптимальный
#   mistral:7b       — 4.1 GB, хорош для задач
#   deepseek-r1:7b   — 4.7 GB, хорош для рассуждений
#   qwen2.5:7b       — 4.7 GB, русский язык
#   codellama:7b     — 3.8 GB, написание кода
DEFAULT_MODELS=llama3.2:3b
